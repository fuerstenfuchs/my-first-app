# Bild-Proxy (EasyCLIProxyAPI, laeuft lokal)
PROXY_URL=http://127.0.0.1:8317
PROXY_TOKEN=

# Supabase — SERVICE-Key, nicht der anon-Key.
# Zu finden im Supabase-Dashboard: Project Settings -> API -> service_role
SUPABASE_URL=https://gsfrbxdesarlhfijmguu.supabase.co
SUPABASE_SERVICE_KEY=

# Feineinstellung (optional, Vorgaben in Klammern)
# Fuer wen dieser Arbeiter laeuft — nur damit die App anzeigen kann,
# dass er laeuft. Zu finden in Supabase unter Authentication.
WORKER_USER_ID=

# Grundtakt. Bei laengerer Ruhe fragt er von selbst seltener (bis 60s) und
# faellt beim ersten Auftrag sofort wieder hierauf zurueck.
POLL_INTERVAL_MS=5000
REQUEST_TIMEOUT_MS=300000
STALE_MINUTES=30
MAX_ATTEMPTS=3

# KI-Vergroesserung (optional, nur fuer SeedVR2 ueber fal.ai).
# Ohne diesen Schluessel laeuft alles Uebrige unveraendert weiter — es
# scheitert nur der eine Auftragstyp, der ihn braucht.
# Schluessel anlegen: https://fal.ai/dashboard/keys
FAL_KEY=
# Wie lange auf fal gewartet wird (600000 = 10 min). Eigener Wert, damit
# REQUEST_TIMEOUT_MS fuer den lokalen Proxy nicht still die fal-Geduld kuerzt.
FAL_TIMEOUT_MS=600000
